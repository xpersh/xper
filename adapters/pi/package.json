{
  "name": "@xper/adapter-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Pi harness adapter for xper's public protocol",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "boundaries": "node scripts/check-boundaries.mjs",
    "build": "tsc --project tsconfig.build.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/__tests__/*.test.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "winston": "3.19.0"
  }
}
