{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "package.json",
      "package-lock.json",
      "biome.json",
      "tsconfig.base.json",
      "scripts/**/*.mjs",
      "adapters/*/scripts/**/*.mjs",
      "adapters/*/**/*.json",
      "adapters/*/**/*.ts",
      "!!adapters/*/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
