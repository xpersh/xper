{
  "name": "xper-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.0",
  "workspaces": [
    "adapters/pi"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "cargo fmt --all && biome format --write .",
    "format:check": "cargo fmt --all -- --check && biome format .",
    "lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings && biome lint . && npm run boundaries",
    "test": "cargo test --workspace --all-targets && npm run test:ts",
    "test:ts": "npm run test --workspace @xper/adapter-pi",
    "typecheck": "npm run typecheck --workspace @xper/adapter-pi"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
