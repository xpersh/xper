{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xper.dev/schemas/judgment-v1.schema.json",
  "title": "Pi Judgment recommendation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evaluation",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planArtifactId",
        "incrementIds",
        "criterionIds",
        "artifacts",
        "logs",
        "baseCommit",
        "evaluatedCommit"
      ],
      "properties": {
        "planArtifactId": {
          "type": "string",
          "pattern": "\\S"
        },
        "incrementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "criterionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "kind",
              "path",
              "version",
              "digest"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "\\S"
              },
              "kind": {
                "type": "string",
                "pattern": "\\S"
              },
              "path": {
                "type": "string",
                "pattern": "^\\.xper/artifacts/[a-zA-Z0-9-]+\\.(md|json|log)$"
              },
              "version": {
                "const": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.xper/artifacts/[a-zA-Z0-9-]+\\.(md|json|log)$"
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "evaluatedCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "assignmentId",
        "verdict",
        "reason",
        "criteria",
        "criticisms"
      ],
      "properties": {
        "kind": {
          "const": "judgment_verdict"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "\\S"
        },
        "verdict": {
          "enum": [
            "ACCEPT",
            "ACCEPT_WITH_DEBT",
            "REWORK_IMPLEMENTATION",
            "REVISIT_DESIGN",
            "REDEFINE",
            "HUMAN_DECISION",
            "REJECT"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterionId",
              "outcome",
              "reason",
              "evidence"
            ],
            "properties": {
              "criterionId": {
                "type": "string",
                "pattern": "\\S"
              },
              "outcome": {
                "enum": [
                  "passed",
                  "failed",
                  "uncertain"
                ]
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        "criticisms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "evidence"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "pattern": "\\S"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        "debts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/debt"
          }
        },
        "humanDecision": {
          "$ref": "#/$defs/humanDecision"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "debts"
                ]
              },
              {
                "required": [
                  "humanDecision"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "enum": [
                  "ACCEPT_WITH_DEBT",
                  "HUMAN_DECISION"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "owner",
        "futureCondition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "pattern": "\\S"
        },
        "futureCondition": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "humanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "evidence"
      ],
      "properties": {
        "question": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
