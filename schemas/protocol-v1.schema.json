{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myugen/xper/schemas/protocol-v1.schema.json",
  "title": "xper bridge protocol v1 message",
  "description": "One LF-terminated JSON-RPC 2.0 message on stdio. The LF is not part of the JSON value.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "version": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "capabilityMap": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "protocolVersion", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "protocolVersion": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "not": { "anyOf": [{ "required": ["result"] }, { "required": ["error"] }] },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "initialize" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/initializeParams" } } }
        },
        {
          "if": { "properties": { "method": { "enum": ["capabilities", "ping", "shutdown", "profile.inspect"] } } },
          "then": { "properties": { "params": { "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "method": { "const": "session.attach" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/sessionAttachParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "session.detach" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/sessionDetachParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "event.ingest" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/errorEventParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "run.start" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/runStartParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "assignment.start" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/assignmentStartParams" } } }
        },
        {
          "if": { "properties": { "method": { "enum": ["run.status"] } } },
          "then": { "properties": { "params": { "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "method": { "const": "run.advance" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/runAdvanceParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "attempt.finish" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/attemptFinishParams" } } }
        }
      ]
    },
    "success": {
      "type": "object",
      "required": ["jsonrpc", "protocolVersion", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "protocolVersion": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/id" },
        "result": { "type": "object" }
      },
      "not": { "anyOf": [{ "required": ["method"] }, { "required": ["error"] }] }
    },
    "failure": {
      "type": "object",
      "required": ["jsonrpc", "protocolVersion", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "protocolVersion": { "$ref": "#/$defs/version" },
        "id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "integer",
              "enum": [-32700, -32600, -32601, -32602, -32603, -32001, -32002, -32003, -32004, -32005]
            },
            "message": { "type": "string" },
            "data": { "type": "object" }
          }
        }
      },
      "not": { "anyOf": [{ "required": ["method"] }, { "required": ["result"] }] }
    },
    "initializeParams": {
      "type": "object",
      "required": ["adapter", "adapterVersion", "capabilities"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "capabilities": { "$ref": "#/$defs/capabilityMap" }
      }
    },
    "initializeResult": {
      "type": "object",
      "required": ["protocolVersion", "bridgeVersion"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/version" },
        "bridgeVersion": { "type": "string", "minLength": 1 }
      }
    },
    "capabilitiesResult": {
      "type": "object",
      "required": ["capabilities"],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilityMap" },
        "maxFrameBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "pingResult": {
      "type": "object",
      "required": ["pong"],
      "properties": { "pong": { "const": true } }
    },
    "shutdownResult": {
      "type": "object",
      "required": ["ok"],
      "properties": { "ok": { "const": true } }
    },
    "sessionAttachParams": {
      "type": "object",
      "required": ["sessionId", "cwd", "mode"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 }
      }
    },
    "sessionDetachParams": {
      "type": "object",
      "required": ["sessionId"],
      "properties": { "sessionId": { "type": "string", "minLength": 1 } }
    },
    "runStartParams": {
      "type": "object",
      "required": ["objective"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "models": { "type": "array", "items": { "$ref": "#/$defs/availableModel" } },
        "policy": { "$ref": "#/$defs/workflowPolicy" }
      },
      "additionalProperties": false
    },
    "availableModel": {
      "type": "object",
      "required": ["provider", "model", "reasoning"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "modelSelection": {
      "type": "object",
      "required": ["context", "provider", "model", "thinking"],
      "properties": {
        "context": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "thinking": { "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] }
      },
      "additionalProperties": false
    },
    "routingSnapshot": {
      "type": "object",
      "required": ["profile", "context", "routes"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "routes": { "type": "object", "additionalProperties": {
          "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/modelSelection" }
        } }
      }
    },
    "profileInspectResult": {
      "type": "object",
      "required": ["routing"],
      "properties": { "routing": { "oneOf": [
        { "$ref": "#/$defs/routingSnapshot" }, { "type": "null" }
      ] } },
      "additionalProperties": false
    },
    "assignmentStartResult": {
      "type": "object",
      "required": ["runId", "assignmentId", "attemptId", "role", "selection"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "assignmentId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "phase": {"enum": ["discovery", "define", "design", "breakdown", "plan"]},
        "artifactKind": {"enum": ["discovery_brief", "definition_contract", "design_decisions", "story_map", "execution_plan"]},
        "artifactPath": {"type": "string", "minLength": 1},
        "inputArtifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactInput"}},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "budget": {"type": "object", "required": ["attempts", "timeMs", "costMicros", "concurrency"], "properties": {"attempts": {"type": "integer", "minimum": 0}, "timeMs": {"type": "integer", "minimum": 1}, "costMicros": {"type": ["integer", "null"], "minimum": 0}, "concurrency": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        "selection": { "oneOf": [
          { "$ref": "#/$defs/modelSelection" }, { "type": "null" }
        ] }
      },
      "additionalProperties": false
    },
    "assignmentStartParams": {
      "type": "object",
      "properties": { "assignmentId": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "attemptFinishParams": {
      "type": "object",
      "required": ["attemptId", "outcome"],
      "properties": {
        "attemptId": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["succeeded", "failed", "cancelled", "timed_out"] },
        "artifactPath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workflowPolicy": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attemptTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxCostMicros": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "humanGates": {
          "type": "array",
          "items": {
            "enum": [
              "discovery",
              "define",
              "design",
              "breakdown",
              "plan"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "artifactInput": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "artifact_id",
        "attempt_id",
        "kind",
        "path",
        "version"
      ],
      "additionalProperties": false
    },
    "runAdvanceParams": {
      "type": "object",
      "properties": {
        "approvedArtifactId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "runAdvanceResult": {
      "type": "object",
      "properties": {
        "advanced": {
          "type": "boolean"
        },
        "phase": {
          "enum": [
            "discovery",
            "define",
            "design",
            "breakdown",
            "plan"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "ready": {
          "type": "boolean"
        },
        "resumed": {
          "type": "boolean"
        },
        "humanArtifactId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "advanced",
        "phase"
      ],
      "additionalProperties": false
    },
    "errorEventParams": {
      "type": "object",
      "required": ["sessionId", "kind", "source"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "kind": { "const": "error" },
        "source": { "type": "string", "minLength": 1 },
        "toolCallId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
