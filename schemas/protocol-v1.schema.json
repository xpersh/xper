{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myugen/xper/schemas/protocol-v1.schema.json",
  "title": "xper bridge protocol v1 message",
  "description": "JSON-RPC 2.0 transport v1. eventRecording and configurationResolution capabilities identify the passive recording API. Workflow commands are owned by adapters.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "capabilityMap": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "request": {
      "type": "object",
      "required": [
        "jsonrpc",
        "protocolVersion",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "protocolVersion": {
          "$ref": "#/$defs/version"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "result"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "initialize"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/initializeParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "capabilities",
                  "ping",
                  "shutdown",
                  "profile.inspect"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.attach"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/sessionAttachParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.detach"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/sessionDetachParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "event.ingest"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/errorEventParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "event.append"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/appendEventsParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "run.status"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/runStatusParams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "configuration.resolve"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/resolveConfigurationParams"
              }
            }
          }
        }
      ]
    },
    "success": {
      "type": "object",
      "required": [
        "jsonrpc",
        "protocolVersion",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "protocolVersion": {
          "$ref": "#/$defs/version"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "type": "object"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "method"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    "failure": {
      "type": "object",
      "required": [
        "jsonrpc",
        "protocolVersion",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "protocolVersion": {
          "$ref": "#/$defs/version"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "enum": [
                -32700,
                -32600,
                -32601,
                -32602,
                -32603,
                -32001,
                -32002,
                -32003,
                -32004,
                -32005
              ]
            },
            "message": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "method"
            ]
          },
          {
            "required": [
              "result"
            ]
          }
        ]
      }
    },
    "initializeParams": {
      "type": "object",
      "required": [
        "adapter",
        "adapterVersion",
        "capabilities"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "$ref": "#/$defs/capabilityMap"
        }
      }
    },
    "initializeResult": {
      "type": "object",
      "required": [
        "protocolVersion",
        "bridgeVersion"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/version"
        },
        "bridgeVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilitiesResult": {
      "type": "object",
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/capabilityMap"
        },
        "maxFrameBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pingResult": {
      "type": "object",
      "required": [
        "pong"
      ],
      "properties": {
        "pong": {
          "const": true
        }
      }
    },
    "shutdownResult": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    "sessionAttachParams": {
      "type": "object",
      "required": [
        "sessionId",
        "cwd",
        "mode"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sessionDetachParams": {
      "type": "object",
      "required": [
        "sessionId"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "availableModel": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "reasoning"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "modelSelection": {
      "type": "object",
      "required": [
        "context",
        "provider",
        "model",
        "thinking"
      ],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "thinking": {
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "additionalProperties": false
    },
    "routingSnapshot": {
      "type": "object",
      "required": [
        "profile",
        "context",
        "routes"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "routes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/modelSelection"
            }
          }
        }
      }
    },
    "profileInspectResult": {
      "type": "object",
      "required": [
        "routing"
      ],
      "properties": {
        "routing": {
          "oneOf": [
            {
              "$ref": "#/$defs/routingSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "errorEventParams": {
      "type": "object",
      "required": [
        "sessionId",
        "kind",
        "source"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "error"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "toolCallId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recordedEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "occurredAt",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 256
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 256
        },
        "occurredAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 256
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Envelope names and IDs are limited to 256 UTF-8 bytes; payload remains opaque."
    },
    "appendEventsParams": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/recordedEvent"
          }
        }
      },
      "additionalProperties": false
    },
    "appendEventsResult": {
      "type": "object",
      "required": [
        "accepted",
        "durability"
      ],
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durability": {
          "enum": [
            "persistent",
            "volatile"
          ]
        }
      },
      "additionalProperties": false
    },
    "runStatusParams": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "resolveConfigurationParams": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/availableModel"
          }
        }
      },
      "additionalProperties": false
    },
    "resolveConfigurationResult": {
      "type": "object",
      "required": [
        "routing",
        "adapterConfig"
      ],
      "properties": {
        "routing": {
          "oneOf": [
            {
              "$ref": "#/$defs/routingSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "adapterConfig": {}
      },
      "additionalProperties": false
    },
    "runMetrics": {
      "type": "object",
      "required": [
        "formulaVersion",
        "eventCount",
        "attemptsStarted",
        "attemptsFinished",
        "outcomes",
        "inputTokens",
        "outputTokens",
        "costMicros",
        "usageReports"
      ],
      "properties": {
        "formulaVersion": {
          "const": 1
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attemptsStarted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attemptsFinished": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outcomes": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "inputTokens": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "costMicros": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "usageReports": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "recordedRun": {
      "type": "object",
      "required": [
        "runId",
        "sessionId",
        "status",
        "phase",
        "startedAt",
        "lastEventAt",
        "metrics"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastEventAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "metrics": {
          "$ref": "#/$defs/runMetrics"
        }
      }
    },
    "runStatusResult": {
      "type": "object",
      "required": [
        "run",
        "timeline",
        "durability",
        "nextCursor"
      ],
      "properties": {
        "run": {
          "oneOf": [
            {
              "$ref": "#/$defs/recordedRun"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recordedEvent"
          }
        },
        "durability": {
          "enum": [
            "persistent",
            "volatile"
          ]
        },
        "degradedReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
